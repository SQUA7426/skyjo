# ── Build outputs ─────────────────────────────────────────────────────────────
target/
project/target/
project/project/
project/project/target/

# ── IDE / tooling caches ──────────────────────────────────────────────────────
.bloop/
.metals/
.ammonite/
.idea/
.vscode/
*.class

# ── Git internals (not needed inside the build context) ──────────────────────
.git/
.gitignore
.github/

# ── User data (mounted as a volume at runtime instead) ───────────────────────
saves/

# ── Documentation & scripts (not part of the compiled artifact) ──────────────
README.md
*.sh
*.md
LICENSE

# ── Docker files themselves (avoids a confusing self-reference) ───────────────
Dockerfile
docker-compose.yml
.dockerignore
